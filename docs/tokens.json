{
  "$description": "BigBlueButton 4.0 prototype tokens, reduced from the 'Current vs Improved' canvas (RoomImproved, Shell, StatusList). DTCG format. Tiers: primitive -> semantic -> component.",
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0":   { "$value": "#ffffff" },
        "50":  { "$value": "#eef1f5" },
        "100": { "$value": "#e6eaef" },
        "200": { "$value": "#dbe1e8" },
        "300": { "$value": "#c9d2dd" },
        "400": { "$value": "#a9b6c6" },
        "500": { "$value": "#7b8594", "$description": "3.7:1 on white: icons and borders only, never body text" },
        "600": { "$value": "#5b6574", "$description": "Lightest grey that passes 4.5:1 on both white and neutral-50" },
        "700": { "$value": "#4b5563" },
        "800": { "$value": "#374151" },
        "900": { "$value": "#1f2933" },
        "950": { "$value": "#111827" }
      },
      "stage": {
        "900": { "$value": "#0b1220" },
        "800": { "$value": "#0f1724" },
        "700": { "$value": "#16233a" },
        "600": { "$value": "#26364b" },
        "500": { "$value": "#2c3e55" }
      },
      "blue": {
        "50":  { "$value": "#e8f0fd" },
        "300": { "$value": "#8ab8ff", "$description": "Accent text on the dark stage" },
        "600": { "$value": "#1f62d0" }
      },
      "green": {
        "300": { "$value": "#3ecf8e", "$description": "Live/speaking on the dark stage" },
        "500": { "$value": "#12a150", "$description": "Indicator fills only (3.4:1 on white)" },
        "700": { "$value": "#12805c", "$description": "Green text on light surfaces" }
      },
      "amber": {
        "50":  { "$value": "#fff8eb" },
        "400": { "$value": "#f5a524" },
        "700": { "$value": "#9a5b00" },
        "950": { "$value": "#1f1300", "$description": "Text on amber-400" }
      },
      "red": {
        "300": { "$value": "#ff8f8f", "$description": "Danger text on the dark stage" },
        "500": { "$value": "#d93a2b", "$description": "Fills, e.g. Leave; white on it is 4.6:1" },
        "700": { "$value": "#b42318", "$description": "Danger text on light surfaces" }
      },
      "avatar": {
        "$description": "All pass 4.5:1 with white initials",
        "1": { "$value": "#b5542e" },
        "2": { "$value": "#3d5a99" },
        "3": { "$value": "#7a4fb5" },
        "4": { "$value": "#2f6db3" },
        "5": { "$value": "#a23c64" },
        "6": { "$value": "#2b7a6f" },
        "7": { "$value": "#4e6b2a" },
        "8": { "$value": "#8a5a12" }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": ["Source Sans 3", "Source Sans Pro", "system-ui", "sans-serif"] },
        "mono": { "$value": ["ui-monospace", "Menlo", "monospace"] }
      },
      "size": {
        "$type": "dimension",
        "$description": "Collapsed from 10, 11, 11.5, 12, 12.5, 13, 13.5, 14, 14.5, 15, 17, 18px",
        "2xs": { "$value": "11px", "$description": "Section kickers, uppercase" },
        "xs":  { "$value": "12px" },
        "sm":  { "$value": "13px" },
        "md":  { "$value": "14px", "$description": "Default UI and body" },
        "lg":  { "$value": "16px" },
        "xl":  { "$value": "18px", "$description": "Panel titles" }
      },
      "lineHeight": {
        "$type": "dimension",
        "$description": "On the 4px grid",
        "2xs": { "$value": "16px" },
        "xs":  { "$value": "16px" },
        "sm":  { "$value": "20px" },
        "md":  { "$value": "20px" },
        "lg":  { "$value": "24px" },
        "xl":  { "$value": "24px" }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 }
      }
    },
    "radius": {
      "$type": "dimension",
      "$description": "Collapsed from 3 to 24px in twelve steps, on the 4px grid",
      "xs": { "$value": "4px" },
      "md": { "$value": "8px" },
      "lg": { "$value": "12px" },
      "xl": { "$value": "16px" },
      "full": { "$value": "9999px" }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "20px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "surface":          { "$value": "{primitive.color.neutral.0}",   "$description": "Panels, menus, dialogs" },
      "surface-sunken":   { "$value": "{primitive.color.neutral.50}",  "$description": "App background, row hover" },
      "surface-raised":   { "$value": "{primitive.color.neutral.100}", "$description": "Secondary buttons, chips" },
      "surface-stage":    { "$value": "{primitive.color.stage.900}",   "$description": "Behind video and slides" },
      "surface-tile":     { "$value": "{primitive.color.stage.700}",   "$description": "Video tile with camera off" },
      "surface-overlay":  { "$value": "rgba(4,12,24,.75)",             "$description": "Name plates over video" },
      "border":           { "$value": "{primitive.color.neutral.200}" },
      "border-strong":    { "$value": "{primitive.color.neutral.300}" },
      "text":             { "$value": "{primitive.color.neutral.950}" },
      "text-secondary":   { "$value": "{primitive.color.neutral.800}" },
      "text-muted":       { "$value": "{primitive.color.neutral.600}" },
      "text-on-stage":    { "$value": "{primitive.color.neutral.0}" },
      "text-on-stage-muted": { "$value": "{primitive.color.neutral.400}" },
      "icon":             { "$value": "{primitive.color.neutral.700}" },
      "icon-subtle":      { "$value": "{primitive.color.neutral.500}" },
      "accent":           { "$value": "{primitive.color.blue.600}" },
      "accent-soft":      { "$value": "{primitive.color.blue.50}" },
      "on-accent":        { "$value": "{primitive.color.neutral.0}" },
      "focus-ring":       { "$value": "{primitive.color.blue.600}", "$description": "Drawn with a white inner ring so it shows on light panels and the dark stage" },
      "status-live":      { "$value": "{primitive.color.green.500}", "$description": "Mic on / speaking fill. Always pair with an icon" },
      "status-live-text": { "$value": "{primitive.color.green.700}" },
      "status-hand":      { "$value": "{primitive.color.amber.400}" },
      "status-hand-text": { "$value": "{primitive.color.amber.700}" },
      "status-hand-soft": { "$value": "{primitive.color.amber.50}" },
      "danger":           { "$value": "{primitive.color.red.500}" },
      "danger-text":      { "$value": "{primitive.color.red.700}" }
    }
  },
  "component": {
    "control": {
      "$type": "dimension",
      "$description": "Heights for buttons and icon buttons. Below 44px, extend the hit area on touch devices",
      "sm": { "$value": "32px" },
      "md": { "$value": "36px" },
      "lg": { "$value": "40px" },
      "touch": { "$value": "44px" },
      "radius": { "$value": "{primitive.radius.md}" }
    },
    "avatar": {
      "$type": "dimension",
      "sm": { "$value": "24px" },
      "md": { "$value": "32px" },
      "lg": { "$value": "40px" }
    },
    "panel": {
      "$type": "dimension",
      "width": { "$value": "360px" },
      "radius": { "$value": "{primitive.radius.xl}" }
    },
    "tile": {
      "$type": "dimension",
      "radius": { "$value": "{primitive.radius.lg}" },
      "speaking-ring": { "$value": "2px" }
    },
    "row": {
      "$type": "dimension",
      "height": { "$value": "44px" }
    }
  }
}
